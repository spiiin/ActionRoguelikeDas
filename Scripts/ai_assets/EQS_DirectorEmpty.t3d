Begin Object Class=/Script/AIModule.EnvQuery Name="EQS_DirectorEmpty"
   Begin Object Class=/Script/AIModule.EnvQueryGenerator_ActorsOfClass Name="Actors"
   End Object
   Begin Object Class=/Script/AIModule.EnvQueryTest_Distance Name="RejectAll"
   End Object
