   End Object
   Begin Object Name="Actors"
      SearchedActorClass="/Script/CoreUObject.Class'/Script/Engine.PlayerStart'"
      SearchRadius=(DefaultValue=5000000.000000)
   End Object
   Begin Object Name="RejectAll"
      TestPurpose=Filter
      FilterType=Minimum
