Begin Object Class=/Script/AIModule.EnvQuery Name="EQS_DirectorSpawn"
   Begin Object Class=/Script/AIModule.EnvQueryGenerator_Donut Name="Donut"
   End Object
   Begin Object Class=/Script/AIModule.EnvQueryOption Name="SpawnOption"
   End Object
   Begin Object Name="Donut"
      InnerRadius=(DefaultValue=500.000000)
      OuterRadius=(DefaultValue=900.000000)
      NumberOfRings=(DefaultValue=3)
